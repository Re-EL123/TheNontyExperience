# ---- Neon ----
# Pooled connection string (host contains "-pooler") – used by the API at runtime
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) string – used for migrations
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---- Auth ----
# openssl rand -base64 48
JWT_SECRET=change-me
# Used only by `pnpm db:seed` to create the first owner login (12+ chars)
SEED_ADMIN_EMAIL=nonty@re-el.co.za
SEED_ADMIN_PASSWORD=choose-a-long-password

# ---- CORS (public site origins, comma separated, no trailing slash) ----
ALLOWED_ORIGINS=https://YOUR-CUSTOM-DOMAIN,https://re-el123.github.io,http://localhost:3000

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nonty-media
# Public base URL of the bucket (custom domain like https://media.example.com, or the r2.dev URL). No trailing slash.
R2_PUBLIC_URL=https://media.example.com

# ---- Optional: Cloudflare Turnstile on the public enquiry form ----
TURNSTILE_SECRET=
