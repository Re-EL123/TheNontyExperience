{
  "name": "@nonty/shared",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc -p ."
  },
  "dependencies": { "zod": "^3.23.8" },
  "devDependencies": { "tsup": "^8.3.5", "typescript": "^5.6.3" }
}
